[[0.10, 0.90, "Panowie."],
 [0.92, 2.60, "Jeśli widzisz, że Twoja dziewczyna"],
 [2.60, 5.10, "w trudne dni zwija się pod kocem…"],
 [5.30, 7.35, "to jest prezent, na który czeka."],
 [7.45, 8.80, "Otulka to termofor"],
 [8.80, 10.20, "w mięciutkim pasie."],
 [10.25, 12.55, "Zapina go na brzuchu albo plecach…"],
 [12.65, 14.85, "i ciepło jest przy niej cały dzień."],
 [14.90, 17.10, "Nie musisz zgadywać, czego potrzebuje."],
 [17.15, 18.22, "Kup jej Otulkę."],
 [18.25, 20.20, "Zobaczysz, jak się ucieszy."]]

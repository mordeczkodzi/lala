{% comment %}
  Section contract.
  "Co zmienia Otulka?" – two columns: life without the product (✕) vs with it (✓). One point per line.
  @example
  <!-- templates/product.otulka.json, templates/index.json → "split" -->
{% endcomment %}
{%- render 'otulka-assets' -%}
<div class="otk otk-sec{% if section.settings.background == 'white' %} otk-sec--white{% elsif section.settings.background == 'peach' %} otk-sec--peach{% endif %}">
  <div class="otk-wrap">
    <div class="otk-head">
      {%- if section.settings.eyebrow != blank -%}<span class="otk-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="otk-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="otk-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="otk-split">
      {%- assign sides = 'before,after' | split: ',' -%}
      {%- for side in sides -%}
        {%- liquid
          if side == 'before'
            assign side_title = section.settings.left_title
            assign side_points = section.settings.left_points
            assign side_icon = '✕'
          else
            assign side_title = section.settings.right_title
            assign side_points = section.settings.right_points
            assign side_icon = '✓'
          endif
          assign side_list = side_points | newline_to_br | split: '<br />'
        -%}
        <div class="otk-split__col otk-split__col--{{ side }}">
          <h3>{{ side_title }}</h3>
          <ul>
            {%- for point in side_list -%}
              {%- assign point_text = point | strip -%}
              {%- if point_text != blank -%}
                <li><span class="otk-split__ico" aria-hidden="true">{{ side_icon }}</span><span>{{ point_text }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div class="otk-cta-row">
        <a class="otk-btn" href="#otk-buy"{% if section.settings.cta_bundle != blank %} data-otk-pick="{{ section.settings.cta_bundle | escape }}"{% endif %}>{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Otulka – przed i po",
  "tag": "section",
  "class": "otk-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Co zmienia Otulka?" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "left_title", "label": "Lewa kolumna – tytuł", "default": "Bez Otulki" },
    { "type": "textarea", "id": "left_points", "label": "Lewa kolumna – punkty (jeden w linii)", "default": "Leżysz z termoforem pod kocem" },
    { "type": "text", "id": "right_title", "label": "Prawa kolumna – tytuł", "default": "Z Otulką" },
    { "type": "textarea", "id": "right_points", "label": "Prawa kolumna – punkty (jeden w linii)", "default": "Normalnie działasz, a ciepło idzie z Tobą" },
    { "type": "text", "id": "cta_label", "label": "Przycisk (puste = brak)" },
    { "type": "text", "id": "cta_bundle", "label": "Przycisk zaznacza zestaw", "info": "Np. Przytulny. Puste = bez zmiany." },
    { "type": "select", "id": "background", "label": "Tło", "options": [ { "value": "cream", "label": "Kremowe" }, { "value": "white", "label": "Białe" }, { "value": "peach", "label": "Brzoskwiniowe" } ], "default": "white" }
  ],
  "presets": [ { "name": "Otulka – przed i po" } ]
}
{% endschema %}

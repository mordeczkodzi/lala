{% comment %}
  Section contract.
  Footer band: opening hours ("Kiedy pracujemy"), contact details, a short link list and a newsletter signup
  in one row, then a bottom line
  (copyright + store policies) on the same grid, plus the "back to top" button (assets/otulka-global.js).
  Hours are one line each in "Dzień | godziny" format.
  @example
  <!-- sections/footer-group.json → "otulka_info" -->
{% endcomment %}
{%- liquid
  assign contact_email = section.settings.email | default: shop.email
  assign hour_lines = section.settings.hours | newline_to_br | split: '<br />'
  assign news_form_id = 'otk-news-' | append: section.id
-%}
{%- render 'otulka-assets' -%}
<div class="otk otk-foot">
  <div class="otk-wrap otk-foot__grid">
    <div class="otk-foot__col">
      <p class="otk-foot__title">{{ section.settings.hours_title }}</p>
      <ul class="otk-foot__hours">
        {%- for line in hour_lines -%}
          {%- assign line_text = line | strip -%}
          {%- if line_text != blank -%}
            {%- assign parts = line_text | split: '|' -%}
            <li><span>{{ parts[0] | strip }}</span><b>{{ parts[1] | strip }}</b></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.hours_note != blank -%}<p class="otk-foot__note">{{ section.settings.hours_note }}</p>{%- endif -%}
    </div>
    <div class="otk-foot__col">
      <p class="otk-foot__title">{{ section.settings.contact_title }}</p>
      {%- if contact_email != blank -%}
        <p class="otk-foot__line">{% render 'otulka-icon', name: 'mail' %}<a href="mailto:{{ contact_email }}">{{ contact_email }}</a></p>
      {%- endif -%}
      <p class="otk-foot__line">{% render 'otulka-icon', name: 'chat' %}<a href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ section.settings.contact_link_label }}</a></p>
      {%- if section.settings.contact_note != blank -%}<p class="otk-foot__note">{{ section.settings.contact_note }}</p>{%- endif -%}
    </div>
    {%- assign foot_menu = section.settings.menu -%}
    {%- if foot_menu != blank and foot_menu.links.size > 0 -%}
      <div class="otk-foot__col">
        <p class="otk-foot__title">{{ section.settings.menu_title }}</p>
        <ul class="otk-foot__links">
          {%- for link in foot_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    {%- if section.settings.show_newsletter -%}
      <div class="otk-foot__col otk-foot__col--news">
        <p class="otk-foot__title">{{ section.settings.news_title }}</p>
        {%- if section.settings.news_text != blank -%}<p class="otk-foot__text">{{ section.settings.news_text }}</p>{%- endif -%}
        {%- form 'customer', id: news_form_id, class: 'otk-news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="otk-news__msg" role="status">{{ section.settings.news_success }}</p>
          {%- else -%}
            <div class="otk-news__row">
              <label class="otk-vh" for="OtkNews-{{ section.id }}">{{ section.settings.news_placeholder }}</label>
              <input
                id="OtkNews-{{ section.id }}"
                type="email"
                name="contact[email]"
                required
                autocomplete="email"
                placeholder="{{ section.settings.news_placeholder | escape }}"
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
              >
              <button type="submit" aria-label="{{ section.settings.news_button | escape }}">
                {%- render 'otulka-icon', name: 'next' -%}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="otk-news__msg otk-news__msg--error" role="alert">Sprawdź adres e-mail i spróbuj ponownie.</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
  {%- if section.settings.show_bottom -%}
    <div class="otk-wrap"><div class="otk-foot__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if shop.policies.size > 0 -%}
        <ul class="otk-foot__policies">
          {%- for policy in shop.policies -%}
            {%- liquid
              assign policy_title = policy.title
              if policy.url contains 'refund-policy'
                assign policy_title = 'Zwroty'
              elsif policy.url contains 'privacy-policy'
                assign policy_title = 'Polityka prywatności'
              elsif policy.url contains 'terms-of-service'
                assign policy_title = 'Regulamin'
              elsif policy.url contains 'shipping-policy'
                assign policy_title = 'Dostawa'
              elsif policy.url contains 'contact-information'
                assign policy_title = 'Dane sprzedawcy'
              elsif policy.url contains 'legal-notice'
                assign policy_title = 'Nota prawna'
              elsif policy.title contains 'ookie'
                assign policy_title = 'Ustawienia cookies'
              endif
            -%}
            <li><a href="{{ policy.url }}">{{ policy_title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div></div>
  {%- endif -%}
</div>

{%- if section.settings.show_top -%}
  <button type="button" class="otk-top" data-otk-top aria-label="{{ section.settings.top_label | escape }}" hidden>
    {%- render 'otulka-icon', name: 'up' -%}
  </button>
{%- endif -%}
<script src="{{ 'otulka-global.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Otulka – godziny pracy",
  "tag": "section",
  "class": "otk-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "hours_title", "label": "Tytuł godzin", "default": "Kiedy pracujemy" },
    { "type": "textarea", "id": "hours", "label": "Godziny (Dzień | godziny, jeden w linii)", "default": "Pon – pt | 9:00 – 17:00\nSob – nd | nieczynne" },
    { "type": "text", "id": "hours_note", "label": "Dopisek pod godzinami", "default": "Wiadomości z weekendu odbieramy w poniedziałek." },
    { "type": "text", "id": "contact_title", "label": "Tytuł kontaktu", "default": "Kontakt" },
    { "type": "text", "id": "email", "label": "E-mail", "info": "Puste = e-mail sklepu." },
    { "type": "text", "id": "contact_link_label", "label": "Link do formularza – tekst", "default": "Formularz kontaktowy" },
    { "type": "text", "id": "contact_link", "label": "Link do formularza", "default": "/pages/contact" },
    { "type": "text", "id": "contact_note", "label": "Dopisek pod kontaktem", "default": "Odpowiadamy na każdą wiadomość." },
    { "type": "text", "id": "menu_title", "label": "Tytuł linków", "default": "Informacje" },
    { "type": "link_list", "id": "menu", "label": "Menu z linkami", "default": "footer" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Pokaż zapis do newslettera", "default": true },
    { "type": "text", "id": "news_title", "label": "Tytuł", "default": "Bądź na bieżąco" },
    { "type": "text", "id": "news_text", "label": "Tekst", "default": "Nowości i promocje Otulki prosto na Twoją skrzynkę." },
    { "type": "text", "id": "news_placeholder", "label": "Podpowiedź w polu", "default": "Adres e-mail" },
    { "type": "text", "id": "news_button", "label": "Opis przycisku (dla czytników ekranu)", "default": "Zapisz się" },
    { "type": "text", "id": "news_success", "label": "Komunikat po zapisie", "default": "Dzięki! Jesteś na liście." },
    { "type": "header", "content": "Dół stopki" },
    { "type": "checkbox", "id": "show_bottom", "label": "Pokaż prawa autorskie i regulaminy", "default": true },
    { "type": "checkbox", "id": "show_top", "label": "Pokaż przycisk „do góry”", "default": true },
    { "type": "text", "id": "top_label", "label": "Opis przycisku „do góry” (dla czytników ekranu)", "default": "Wróć na górę strony" }
  ],
  "presets": [ { "name": "Otulka – godziny pracy" } ]
}
{% endschema %}

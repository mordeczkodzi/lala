{% comment %}
  Section contract.
  Comparison table: our product vs two generic alternatives. Each row block sets ✓/✗ per column.
  @example
  <!-- templates/product.otulka.json → "compare" -->
{% endcomment %}
{%- render 'otulka-assets' -%}
<div class="otk otk-sec{% if section.settings.background == 'white' %} otk-sec--white{% elsif section.settings.background == 'peach' %} otk-sec--peach{% endif %}">
  <div class="otk-wrap">
    <div class="otk-head">
      {%- if section.settings.eyebrow != blank -%}<span class="otk-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="otk-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="otk-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="otk-table-wrap">
      <table class="otk-table">
        <thead>
          <tr>
            <th scope="col"><span class="otk-vh">Cecha</span></th>
            <th scope="col" class="is-us">{{ section.settings.col_us }}</th>
            <th scope="col">{{ section.settings.col_a }}</th>
            {%- if section.settings.col_b != blank -%}<th scope="col">{{ section.settings.col_b }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td class="is-us">{% if block.settings.us %}<span class="otk-yes" aria-label="Tak">✓</span>{% else %}<span class="otk-no" aria-label="Nie">✕</span>{% endif %}</td>
              <td>{% if block.settings.a %}<span class="otk-yes" aria-label="Tak">✓</span>{% else %}<span class="otk-no" aria-label="Nie">✕</span>{% endif %}</td>
              {%- if section.settings.col_b != blank -%}
                <td>{% if block.settings.b %}<span class="otk-yes" aria-label="Tak">✓</span>{% else %}<span class="otk-no" aria-label="Nie">✕</span>{% endif %}</td>
              {%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div class="otk-cta-row">
        <a class="otk-btn" href="#otk-buy">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Otulka – porównanie",
  "tag": "section",
  "class": "otk-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Dlaczego Otulka?" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "col_us", "label": "Kolumna 1 (my)", "default": "Otulka" },
    { "type": "text", "id": "col_a", "label": "Kolumna 2", "default": "Zwykły termofor" },
    { "type": "text", "id": "col_b", "label": "Kolumna 3 (puste = ukryta)", "default": "Poduszka elektryczna" },
    { "type": "text", "id": "cta_label", "label": "Przycisk (puste = brak)" },
    { "type": "select", "id": "background", "label": "Tło", "options": [ { "value": "cream", "label": "Kremowe" }, { "value": "white", "label": "Białe" }, { "value": "peach", "label": "Brzoskwiniowe" } ], "default": "cream" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Wiersz",
      "settings": [
        { "type": "text", "id": "feature", "label": "Cecha", "default": "Wolne ręce" },
        { "type": "checkbox", "id": "us", "label": "Kolumna 1", "default": true },
        { "type": "checkbox", "id": "a", "label": "Kolumna 2", "default": false },
        { "type": "checkbox", "id": "b", "label": "Kolumna 3", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Otulka – porównanie", "blocks": [ { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
